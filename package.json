{
    "name": "virtual-tabs",
    "displayName": "VirtualTabs - Virtual File Directories & AI context management",
    "description": "%extension.description%",
    "version": "0.14.0",
    "publisher": "winterdrive",
    "icon": "docs/assets/virtualtabs_icon_128.png",
    "categories": [
        "Other"
    ],
    "keywords": [
        "virtual file directories",
        "file grouping",
        "virtual tabs",
        "tab organization",
        "workspace organizer",
        "monorepo",
        "productivity",
        "ai context",
        "bookmarks",
        "cross-directory",
        "chatgpt",
        "copilot",
        "mcp",
        "model context protocol",
        "agent skill"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/winterdrive/virtual-tabs"
    },
    "bugs": {
        "url": "https://github.com/winterdrive/virtual-tabs/issues"
    },
    "homepage": "https://github.com/winterdrive/virtual-tabs",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "Virtual Tabs",
            "properties": {
                "virtualTabs.autoRevealActiveFile": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.autoRevealActiveFile.description%"
                },
                "virtualTabs.confirmBeforeDelete": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.confirmBeforeDelete.description%"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "virtualTabsContainer",
                    "title": "%view.virtualTabsContainer.title%",
                    "icon": "docs/assets/virtualtabs_icon_gray.svg"
                }
            ]
        },
        "views": {
            "virtualTabsContainer": [
                {
                    "id": "virtualTabsView",
                    "name": "%view.virtualTabsView.name%",
                    "icon": "docs/assets/virtualtabs_icon_gray.svg",
                    "dragAndDrop": true
                }
            ]
        },
        "commands": [
            {
                "command": "virtualTabs.addGroup",
                "title": "%command.addGroup.title%",
                "icon": "$(new-folder)",
                "shortTitle": "Add Group"
            },
            {
                "command": "virtualTabs.removeGroup",
                "title": "%command.removeGroup.title%",
                "icon": "$(trash)"
            },
            {
                "command": "virtualTabs.renameGroup",
                "title": "%command.renameGroup.title%"
            },
            {
                "command": "virtualTabs.duplicateGroup",
                "title": "%command.duplicateGroup.title%"
            },
            {
                "command": "virtualTabs.duplicateBuiltInGroup",
                "title": "%command.duplicateBuiltInGroup.title%"
            },
            {
                "command": "virtualTabs.addSubGroup",
                "title": "%command.addSubGroup.title%"
            },
            {
                "command": "virtualTabs.moveGroupUp",
                "title": "%command.moveGroupUp.title%"
            },
            {
                "command": "virtualTabs.moveGroupDown",
                "title": "%command.moveGroupDown.title%"
            },
            {
                "command": "virtualTabs.moveScopeUp",
                "title": "Move Scope Up"
            },
            {
                "command": "virtualTabs.moveScopeDown",
                "title": "Move Scope Down"
            },
            {
                "command": "virtualTabs.refreshBuiltInGroup",
                "title": "%command.refreshBuiltInGroup.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "virtualTabs.refresh",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "virtualTabs.selectScope",
                "title": "Select Scope",
                "icon": "$(list-selection)"
            },
            {
                "command": "virtualTabs.autoGroupByExt",
                "title": "%command.autoGroupByExt.title%"
            },
            {
                "command": "virtualTabs.addSelectedFilesToGroup",
                "title": "%command.addSelectedFilesToGroup.title%"
            },
            {
                "command": "virtualTabs.openAllFiles",
                "title": "%command.openAllFiles.title%"
            },
            {
                "command": "virtualTabs.closeAllFiles",
                "title": "%command.closeAllFiles.title%"
            },
            {
                "command": "virtualTabs.openSelectedFiles",
                "title": "%command.openSelectedFiles.title%"
            },
            {
                "command": "virtualTabs.closeSelectedFiles",
                "title": "%command.closeSelectedFiles.title%"
            },
            {
                "command": "virtualTabs.runFile",
                "title": "%command.runFile.title%",
                "icon": "$(run)"
            },
            {
                "command": "virtualTabs.generateAgentSkill",
                "title": "%command.generateAgentSkill.title%",
                "icon": "$(cloud-download)"
            },
            {
                "command": "virtualTabs.showMcpConfig",
                "title": "VirtualTabs: Show MCP Config",
                "icon": "$(gear)",
                "shortTitle": "MCP Config"
            },
            {
                "command": "virtualTabs.removeSelectedFilesFromGroup",
                "title": "%command.removeSelectedFilesFromGroup.title%"
            },
            {
                "command": "virtualTabs.deleteFile",
                "title": "%command.deleteFile.title%"
            },
            {
                "command": "virtualTabs.copyAbsolutePath",
                "title": "Copy Absolute Path"
            },
            {
                "command": "virtualTabs.copyFileName",
                "title": "%command.copyFileName.title%"
            },
            {
                "command": "virtualTabs.copyRelativePath",
                "title": "%command.copyRelativePath.title%"
            },
            {
                "command": "revealFileInOS",
                "title": "%command.revealFileInOS.title%"
            },
            {
                "command": "virtualTabs.removeFileFromGroup",
                "title": "%command.removeFileFromGroup.title%",
                "icon": "$(trash)"
            },
            {
                "command": "virtualTabs.sortByName",
                "title": "%command.sortByName.title%"
            },
            {
                "command": "virtualTabs.sortByPath",
                "title": "%command.sortByPath.title%"
            },
            {
                "command": "virtualTabs.sortByExtension",
                "title": "%command.sortByExtension.title%"
            },
            {
                "command": "virtualTabs.sortByModified",
                "title": "%command.sortByModified.title%"
            },
            {
                "command": "virtualTabs.toggleSortOrder",
                "title": "%command.toggleSortOrder.title%"
            },
            {
                "command": "virtualTabs.clearSort",
                "title": "%command.clearSort.title%"
            },
            {
                "command": "virtualTabs.autoGroupByModifiedDate",
                "title": "%command.autoGroupByModifiedDate.title%"
            },
            {
                "command": "virtualTabs.addBookmark",
                "title": "%command.addBookmark.title%"
            },
            {
                "command": "virtualTabs.jumpToBookmark",
                "title": "%command.jumpToBookmark.title%"
            },
            {
                "command": "virtualTabs.editBookmarkLabel",
                "title": "%command.editBookmarkLabel.title%"
            },
            {
                "command": "virtualTabs.editBookmarkDescription",
                "title": "%command.editBookmarkDescription.title%"
            },
            {
                "command": "virtualTabs.removeBookmark",
                "title": "%command.removeBookmark.title%",
                "icon": "$(trash)"
            },
            {
                "command": "virtualTabs.copyGroupContext",
                "title": "%command.copyGroupContext.title%"
            },
            {
                "command": "virtualTabs.copyGroupPaths",
                "title": "%command.copyGroupPaths.title%"
            },
            {
                "command": "virtualTabs.copyName",
                "title": "%command.copyName.title%"
            },
            {
                "command": "virtualTabs.delete",
                "title": "Delete"
            },
            {
                "command": "virtualTabs.copy",
                "title": "Copy"
            },
            {
                "command": "virtualTabs.paste",
                "title": "Paste"
            },
            {
                "command": "virtualTabs.closeBookmarkContainer",
                "title": "Close File"
            },
            {
                "command": "virtualTabs.closeFile",
                "title": "%command.closeFile.title%",
                "icon": "$(close)"
            },
            {
                "command": "virtualTabs.sendTo",
                "title": "%command.sendTo.title%",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "virtualTabs.sendToIncludeGroupFolder",
                "title": "%command.sendToIncludeGroupFolder.title%",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "virtualTabs.sendToExcludeGroupFolder",
                "title": "%command.sendToExcludeGroupFolder.title%",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "virtualTabs.moveFileUp",
                "title": "%command.moveFileUp.title%"
            },
            {
                "command": "virtualTabs.moveFileDown",
                "title": "%command.moveFileDown.title%"
            },
            {
                "command": "virtualTabs.addGroupToScope",
                "title": "Add Group to Scope",
                "icon": "$(add)"
            },
            {
                "command": "virtualTabs.clearScope",
                "title": "Clear Scope",
                "icon": "$(clear-all)"
            },
            {
                "command": "virtualTabs.openScopeConfig",
                "title": "Open Config",
                "icon": "$(json)"
            },
            {
                "command": "virtualTabs.revealScopeStorage",
                "title": "Reveal Storage",
                "icon": "$(folder-opened)"
            }
        ],
        "submenus": [
            {
                "id": "virtualTabs.sortMenu.group",
                "label": "%submenu.sortFiles.label%"
            },
            {
                "id": "virtualTabs.sortMenu.builtIn",
                "label": "%submenu.sortFiles.label%"
            },
            {
                "id": "virtualTabs.copyMenu.unified",
                "label": "Copy..."
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "virtualTabs.showMcpConfig",
                    "when": "true"
                }
            ],
            "view/title": [
                {
                    "command": "virtualTabs.selectScope",
                    "when": "view == virtualTabsView",
                    "group": "navigation@1"
                },
                {
                    "command": "virtualTabs.refresh",
                    "when": "view == virtualTabsView",
                    "group": "navigation@2"
                },
                {
                    "command": "virtualTabs.addGroup",
                    "when": "view == virtualTabsView && !virtualTabs:hasMultipleScopes",
                    "group": "navigation@3"
                },
                {
                    "command": "virtualTabs.showMcpConfig",
                    "when": "view == virtualTabsView",
                    "group": "navigation@4"
                },
                {
                    "command": "virtualTabs.generateAgentSkill",
                    "when": "view == virtualTabsView",
                    "group": "navigation@5"
                }
            ],
            "view/item/context": [
                {
                    "command": "virtualTabs.addGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "1_basic@1"
                },
                {
                    "command": "virtualTabs.addSubGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "1_basic@2"
                },
                {
                    "command": "virtualTabs.renameGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "1_basic@3"
                },
                {
                    "command": "virtualTabs.duplicateGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "1_basic@4"
                },
                {
                    "command": "virtualTabs.moveGroupUp",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "3_organize@0"
                },
                {
                    "command": "virtualTabs.moveGroupDown",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "3_organize@0.1"
                },
                {
                    "command": "virtualTabs.openAllFiles",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "2_files@1"
                },
                {
                    "command": "virtualTabs.closeAllFiles",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "2_files@2"
                },
                {
                    "submenu": "virtualTabs.sortMenu.group",
                    "when": "view == virtualTabsView && viewItem =~ /virtualTabsGroup.*/",
                    "group": "3_organize@1"
                },
                {
                    "command": "virtualTabs.autoGroupByExt",
                    "when": "view == virtualTabsView && viewItem =~ /virtualTabsGroup.*/",
                    "group": "3_organize@2"
                },
                {
                    "command": "virtualTabs.autoGroupByModifiedDate",
                    "when": "view == virtualTabsView && viewItem =~ /virtualTabsGroup.*/",
                    "group": "3_organize@3"
                },
                {
                    "submenu": "virtualTabs.copyMenu.unified",
                    "when": "view == virtualTabsView && (viewItem =~ /virtualTabsGroup.*/ || virtualTabs:hasFileSelected || viewItem == virtualTabsBookmark)",
                    "group": "5_copy@1"
                },
                {
                    "command": "virtualTabs.removeGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroup",
                    "group": "inline@1"
                },
                {
                    "command": "virtualTabs.addGroupToScope",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "inline@1"
                },
                {
                    "command": "virtualTabs.moveScopeUp",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "3_organize@1"
                },
                {
                    "command": "virtualTabs.moveScopeDown",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "3_organize@2"
                },
                {
                    "command": "virtualTabs.openScopeConfig",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "4_storage@1"
                },
                {
                    "command": "virtualTabs.revealScopeStorage",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "4_storage@2"
                },
                {
                    "command": "virtualTabs.clearScope",
                    "when": "view == virtualTabsView && viewItem == virtualTabsScopeHeaderWithAdd",
                    "group": "9_delete@1"
                },
                {
                    "command": "virtualTabs.refreshBuiltInGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroupBuiltIn",
                    "group": "inline@1"
                },
                {
                    "command": "virtualTabs.addGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroupBuiltIn",
                    "group": "1_basic@1"
                },
                {
                    "command": "virtualTabs.duplicateBuiltInGroup",
                    "when": "view == virtualTabsView && viewItem == virtualTabsGroupBuiltIn",
                    "group": "1_basic@4"
                },
                {
                    "command": "virtualTabs.openSelectedFiles",
                    "when": "view == virtualTabsView && virtualTabs:hasFileSelected && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileBuiltIn || viewItem == virtualTabsFileCustomExec || viewItem == virtualTabsFileBuiltInExec)",
                    "group": "1_open@1"
                },
                {
                    "command": "virtualTabs.closeSelectedFiles",
                    "when": "view == virtualTabsView && virtualTabs:hasFileSelected && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileBuiltIn || viewItem == virtualTabsFileCustomExec || viewItem == virtualTabsFileBuiltInExec)",
                    "group": "1_open@2"
                },
                {
                    "command": "virtualTabs.runFile",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsFileCustomExec || viewItem == virtualTabsFileBuiltInExec)",
                    "group": "inline@0"
                },
                {
                    "command": "virtualTabs.closeFile",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsFileBuiltIn || viewItem == virtualTabsFileBuiltInExec)",
                    "group": "inline@1"
                },
                {
                    "command": "revealFileInOS",
                    "when": "view == virtualTabsView && ((virtualTabs:hasFileSelected && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileBuiltIn || viewItem == virtualTabsFileCustomExec || viewItem == virtualTabsFileBuiltInExec)) || viewItem == virtualTabsBookmark)",
                    "group": "4_system@1"
                },
                {
                    "command": "virtualTabs.removeFileFromGroup",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileCustomExec)",
                    "group": "inline@2"
                },
                {
                    "command": "virtualTabs.removeSelectedFilesFromGroup",
                    "when": "view == virtualTabsView && virtualTabs:hasCustomFileSelected && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileCustomExec)",
                    "group": "3_modify@1"
                },
                {
                    "command": "virtualTabs.deleteFile",
                    "when": "view == virtualTabsView && viewItem =~ /virtualTabsFile.*/",
                    "group": "9_delete@2"
                },
                {
                    "command": "virtualTabs.jumpToBookmark",
                    "when": "view == virtualTabsView && viewItem == virtualTabsBookmark",
                    "group": "1_open@1"
                },
                {
                    "command": "virtualTabs.closeBookmarkContainer",
                    "when": "view == virtualTabsView && viewItem == virtualTabsBookmark",
                    "group": "1_open@2"
                },
                {
                    "command": "virtualTabs.editBookmarkLabel",
                    "when": "view == virtualTabsView && viewItem == virtualTabsBookmark",
                    "group": "1_edit@1"
                },
                {
                    "command": "virtualTabs.editBookmarkDescription",
                    "when": "view == virtualTabsView && viewItem == virtualTabsBookmark",
                    "group": "1_edit@2"
                },
                {
                    "command": "virtualTabs.removeBookmark",
                    "when": "view == virtualTabsView && viewItem == virtualTabsBookmark",
                    "group": "inline@2"
                },
                {
                    "command": "virtualTabs.sendTo",
                    "when": "view == virtualTabsView && virtualTabs:hasFileSelected && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileBuiltIn || viewItem == virtualTabsFileCustomExec || viewItem == virtualTabsFileBuiltInExec)",
                    "group": "9_sendTo@1"
                },
                {
                    "command": "virtualTabs.sendToIncludeGroupFolder",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsGroup || viewItem == virtualTabsGroupBuiltIn)",
                    "group": "9_sendTo@2"
                },
                {
                    "command": "virtualTabs.sendToExcludeGroupFolder",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsGroup || viewItem == virtualTabsGroupBuiltIn)",
                    "group": "9_sendTo@3"
                },
                {
                    "command": "virtualTabs.moveFileUp",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileCustomExec)",
                    "group": "3_organize@0.2"
                },
                {
                    "command": "virtualTabs.moveFileDown",
                    "when": "view == virtualTabsView && (viewItem == virtualTabsFileCustom || viewItem == virtualTabsFileCustomExec)",
                    "group": "3_organize@0.3"
                }
            ],
            "editor/context": [
                {
                    "command": "virtualTabs.addBookmark",
                    "when": "editorTextFocus",
                    "group": "virtualTabs"
                }
            ],
            "virtualTabs.sortMenu.group": [
                {
                    "command": "virtualTabs.sortByName",
                    "group": "1_sort@1"
                },
                {
                    "command": "virtualTabs.sortByPath",
                    "group": "1_sort@2"
                },
                {
                    "command": "virtualTabs.sortByExtension",
                    "group": "1_sort@3"
                },
                {
                    "command": "virtualTabs.sortByModified",
                    "group": "1_sort@4"
                },
                {
                    "command": "virtualTabs.toggleSortOrder",
                    "group": "2_order@1"
                },
                {
                    "command": "virtualTabs.clearSort",
                    "group": "3_actions@1"
                }
            ],
            "virtualTabs.sortMenu.builtIn": [
                {
                    "command": "virtualTabs.sortByName",
                    "group": "1_sort@1"
                },
                {
                    "command": "virtualTabs.sortByPath",
                    "group": "1_sort@2"
                },
                {
                    "command": "virtualTabs.sortByExtension",
                    "group": "1_sort@3"
                },
                {
                    "command": "virtualTabs.sortByModified",
                    "group": "1_sort@4"
                },
                {
                    "command": "virtualTabs.toggleSortOrder",
                    "group": "2_order@1"
                },
                {
                    "command": "virtualTabs.clearSort",
                    "group": "3_actions@1"
                }
            ],
            "virtualTabs.copyMenu.unified": [
                {
                    "command": "virtualTabs.copyName",
                    "group": "1_name@1"
                },
                {
                    "command": "virtualTabs.copyGroupContext",
                    "group": "2_ai@1"
                },
                {
                    "command": "virtualTabs.copyFileName",
                    "group": "3_info@1"
                },
                {
                    "command": "virtualTabs.copyRelativePath",
                    "group": "3_info@2"
                },
                {
                    "command": "virtualTabs.copyAbsolutePath",
                    "group": "3_info@3"
                }
            ]
        },
        "keybindings": [
            {
                "command": "virtualTabs.renameGroup",
                "key": "f2",
                "when": "focusedView == virtualTabsView && listFocus"
            },
            {
                "command": "virtualTabs.moveFileUp",
                "key": "alt+up",
                "when": "virtualTabs:hasCustomFileSelected && !editorTextFocus"
            },
            {
                "command": "virtualTabs.moveFileDown",
                "key": "alt+down",
                "when": "virtualTabs:hasCustomFileSelected && !editorTextFocus"
            }
        ]
    },
    "scripts": {
        "test": "tsc -p ./ && jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:properties": "jest --runInBand src/test/properties",
        "test:ui:setup": "extest setup-tests",
        "test:ui": "tsc -p tsconfig.test.ui.json && extest setup-and-run \"out/test/ui/**/*.test.js\" -e \".vscode-test/extensions\" -r \"test-resources/multi-root/virtual-tabs.code-workspace\" -c 1.96.0",
        "test:ui:demo": "node src/test/ui/demo/write-demo-settings.cjs && tsc -p tsconfig.test.ui.json && node -e \"const fs=require('fs');const p=require('path').join(require('os').tmpdir(),'test-resources','settings');if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})\" && extest setup-and-run \"out/test/ui/demo/groupOrganize.demo.js\" -e \".vscode-test/extensions\" -r \"test-resources/demo-workspace\" -c 1.96.0 -o \"test-results/demo-vscode-settings.generated.json\"",
        "test:ui:selfroot": "tsc -p tsconfig.test.ui.json && extest setup-and-run \"out/test/ui/selfRoot/**/*.selfroot.js\" -e \".vscode-test/extensions\" -r \"test-resources/self-root/project.code-workspace\" -c 1.96.0",
        "docs:llms": "node scripts/generate-llms-full.mjs",
        "docs:llms:check": "node scripts/generate-llms-full.mjs --check",
        "vscode:prepublish": "npm run build:vt && npm run build:mcp && tsc -p ./ && npm run build:skills",
        "build:mcp": "esbuild mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp/index.js --external:vscode",
        "build:vt": "npx tsx scripts/bundle-vt.ts",
        "build:skills": "node -e \"const fs=require('fs');fs.mkdirSync('dist/skills/virtualtabs',{recursive:true});fs.copyFileSync('skills/virtualtabs/SKILL.md','dist/skills/virtualtabs/SKILL.md');fs.mkdirSync('skills/virtualtabs/scripts',{recursive:true});fs.copyFileSync('dist/vt.bundle.js','skills/virtualtabs/scripts/vt.bundle.js')\""
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@types/chai": "^4.3.20",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.15.29",
        "@types/vscode": "^1.70.0",
        "chai": "^4.5.0",
        "esbuild": "^0.28.1",
        "fast-check": "^4.6.0",
        "jest": "^30.3.0",
        "mocha": "^10.8.2",
        "ts-jest": "^29.4.9",
        "tsx": "^4.22.4",
        "typescript": "^5.9.3",
        "vscode-extension-tester": "^8.14.1",
        "zod": "^4.3.6"
    },
    "dependencies": {
        "fast-glob": "^3.3.3"
    },
